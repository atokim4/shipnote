{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"slug": "base",
					"color": "#F4F1E9",
					"name": "Paper"
				},
				{
					"slug": "base-2",
					"color": "#E9E3D5",
					"name": "Paper shade"
				},
				{
					"slug": "contrast",
					"color": "#16171B",
					"name": "Ink"
				},
				{
					"slug": "contrast-2",
					"color": "#4B4D55",
					"name": "Ink soft"
				},
				{
					"slug": "accent",
					"color": "#F05A22",
					"name": "Signal"
				},
				{
					"slug": "on-accent",
					"color": "#16171B",
					"name": "Ink on signal"
				},
				{
					"slug": "accent-2",
					"color": "#2440B8",
					"name": "Carbon"
				},
				{
					"slug": "rule",
					"color": "#C8C0AE",
					"name": "Rule"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "76rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2X-Small"
				},
				{
					"slug": "30",
					"size": "clamp(0.75rem, 1.5vw, 1rem)",
					"name": "X-Small"
				},
				{
					"slug": "40",
					"size": "clamp(1rem, 2.2vw, 1.5rem)",
					"name": "Small"
				},
				{
					"slug": "50",
					"size": "clamp(1.5rem, 3.5vw, 2.5rem)",
					"name": "Medium"
				},
				{
					"slug": "60",
					"size": "clamp(2rem, 5.5vw, 4rem)",
					"name": "Large"
				},
				{
					"slug": "70",
					"size": "clamp(3rem, 8vw, 6rem)",
					"name": "X-Large"
				},
				{
					"slug": "80",
					"size": "clamp(4rem, 11vw, 8.5rem)",
					"name": "2X-Large"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "0.8125rem",
					"fluid": false,
					"name": "Extra small"
				},
				{
					"slug": "small",
					"size": "0.9375rem",
					"fluid": {
						"min": "0.875rem",
						"max": "0.9375rem"
					},
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					},
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					},
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.25rem"
					},
					"name": "Extra large"
				},
				{
					"slug": "xx-large",
					"size": "3.5rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					},
					"name": "2X large"
				},
				{
					"slug": "huge",
					"size": "5.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "5.5rem"
					},
					"name": "Huge"
				}
			],
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Archivo",
					"fontFamily": "Archivo, \"Arial Narrow\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo/archivo-latin-wdth-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo/archivo-latin-ext-wdth-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "body",
					"name": "Source Serif 4",
					"fontFamily": "\"Source Serif 4\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "normal",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-latin-wght-italic.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Source Serif 4",
							"fontStyle": "italic",
							"fontWeight": "200 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-serif-4/source-serif-4-latin-ext-wght-italic.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "lift",
					"shadow": "0 1px 2px rgb(22 23 27 / 0.08), 0 12px 32px -12px rgb(22 23 27 / 0.28)",
					"name": "Lift"
				}
			]
		},
		"custom": {
			"rule-width": "2px",
			"radius": "3px",
			"line-height": {
				"tight": "1.05",
				"snug": "1.25",
				"body": "1.6"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--50)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "var(--wp--custom--line-height--body)",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-2)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "760",
					"lineHeight": "var(--wp--custom--line-height--snug)",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "var(--wp--custom--line-height--tight)",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.1",
					"letterSpacing": "-0.025em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0",
					"fontWeight": "600"
				}
			},
			"button": {
				"border": {
					"width": "var(--wp--custom--rule-width)",
					"style": "solid",
					"color": "var(--wp--preset--color--contrast)",
					"radius": "var(--wp--custom--radius)"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"spacing": {
					"padding": {
						"top": "0.7em",
						"right": "1.25em",
						"bottom": "0.7em",
						"left": "1.25em"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "0.01em"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--contrast-2)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"cite": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "800",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "560"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--contrast-2)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"letterSpacing": "0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast-2)"
						}
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": {
						"top": "1.25rem",
						"right": "1.5rem",
						"bottom": "1.25rem",
						"left": "1.5rem"
					}
				},
				"border": {
					"radius": "var(--wp--custom--radius)"
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/quote": {
				"border": {
					"top": {
						"width": "var(--wp--custom--rule-width)",
						"style": "solid",
						"color": "var(--wp--preset--color--contrast)"
					},
					"right": {
						"width": "0"
					},
					"bottom": {
						"width": "0"
					},
					"left": {
						"width": "0"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.4"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"border": {
					"top": {
						"width": "var(--wp--custom--rule-width)",
						"style": "solid",
						"color": "var(--wp--preset--color--contrast)"
					},
					"bottom": {
						"width": "var(--wp--custom--rule-width)",
						"style": "solid",
						"color": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"width": "0"
				}
			},
			"core/search": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"radius": "var(--wp--custom--radius)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"width": "1px",
						"style": "solid",
						"color": "var(--wp--preset--color--rule)"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "docs-sidebar",
			"title": "Docs sidebar",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without title",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "blank",
			"title": "Blank canvas",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "page-changelog",
			"title": "Changelog (release notes list)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-docs",
			"title": "Docs page with sidebar",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-wide",
			"title": "Wide page",
			"postTypes": [
				"page"
